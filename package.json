{
  "name": "@xumoses/sentry-miniapp-replay-taro",
  "version": "0.1.0-beta.6",
  "description": "Experimental Taro virtual-DOM Session Replay adapter for sentry-miniapp",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xumoses/sentry-miniapp-replay-taro.git"
  },
  "homepage": "https://github.com/xumoses/sentry-miniapp-replay-taro",
  "type": "commonjs",
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react.mjs",
      "require": "./dist/react.cjs.js"
    },
    "./react/root": {
      "types": "./dist/react/root.d.ts",
      "import": "./dist/react-root.mjs",
      "require": "./dist/react-root.cjs.js"
    },
    "./taro/lifecycle": {
      "types": "./dist/taro/lifecycle.d.ts",
      "import": "./dist/taro-lifecycle.mjs",
      "require": "./dist/taro-lifecycle.cjs.js"
    },
    "./devtools/server": "./devtools/server.cjs",
    "./worker": "./dist/worker/replay-compression.js"
  },
  "bin": {
    "sentry-miniapp-replay-taro-viewer": "devtools/server.cjs"
  },
  "files": [
    "dist",
    "devtools",
    "examples",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vp build && node scripts/build-worker.cjs && node scripts/verify-worker.cjs && tsc -p tsconfig.build.json && node scripts/verify-assets.cjs",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "test": "vp test run",
    "verify:beta-release": "node scripts/verify-beta-release.cjs",
    "prepack": "vp run verify:beta-release",
    "prepublishOnly": "vp run check && vp test run && vp run build",
    "pack:check": "vp run build && vp pm pack -- --dry-run"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": "^26.0.0"
  },
  "packageManager": "pnpm@11.17.0",
  "peerDependencies": {
    "@tarojs/runtime": "^4.2.0",
    "@tarojs/taro": "^4.2.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@tarojs/runtime": {
      "optional": true
    },
    "@tarojs/taro": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@sentry/core": "10.66.0",
    "@tarojs/runtime": "4.2.0",
    "@tarojs/taro": "4.2.0",
    "@types/node": "^20.19.11",
    "@types/react": "^18.3.12",
    "@xumoses/sentry-miniapp": "1.13.1-beta.3",
    "fflate": "0.8.2",
    "react": "^18.3.1",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
