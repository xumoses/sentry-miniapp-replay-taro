{
  "name": "@xumoses/sentry-miniapp-replay-taro",
  "version": "0.1.0-beta.0",
  "description": "Experimental Taro virtual-DOM Session Replay adapter for sentry-miniapp",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xumoses/sentry-miniapp-replay-taro.git"
  },
  "homepage": "https://github.com/xumoses/sentry-miniapp-replay-taro",
  "type": "commonjs",
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react.mjs",
      "require": "./dist/react.cjs.js"
    },
    "./devtools/server": "./devtools/server.cjs"
  },
  "bin": {
    "sentry-miniapp-replay-taro-viewer": "./devtools/server.cjs"
  },
  "files": [
    "dist",
    "devtools",
    "examples",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "lint": "oxlint src test",
    "lint:fix": "oxlint --fix src test",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "verify:beta-release": "node scripts/verify-beta-release.cjs",
    "prepack": "pnpm run verify:beta-release",
    "prepublishOnly": "pnpm run verify:beta-release && pnpm run typecheck && pnpm run lint && pnpm test && pnpm run build",
    "pack:check": "pnpm run verify:beta-release && pnpm run build && pnpm pack --dry-run"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.34.4",
  "peerDependencies": {
    "@sentry/core": "^10.63.0",
    "@tarojs/runtime": "^4.2.0",
    "@tarojs/taro": "^4.2.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@tarojs/runtime": {
      "optional": true
    },
    "@tarojs/taro": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@sentry/core": "^10.63.0",
    "@tarojs/runtime": "4.2.0",
    "@tarojs/taro": "4.2.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.3.12",
    "jest": "^29.7.0",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "react": "^18.3.1",
    "ts-jest": "^29.2.6",
    "typescript": "^5.7.3",
    "vite": "^8.1.5"
  }
}
